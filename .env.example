# =========================================================================
# SMART STUDY PLANNER - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to '.env' and fill in your details. Never commit '.env'!
# On Vercel, set the same variables in Project Settings -> Environment
# Variables.
# =========================================================================

# Flask session secret. REQUIRED in production: without it, a random
# per-process key is used and logins will not persist across restarts
# or serverless instances. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace_with_a_long_random_string

# Database. REQUIRED on Vercel: without it the app falls back to a
# temporary SQLite file and all accounts/plans/tasks are lost between
# serverless instances. Use a hosted PostgreSQL (e.g. Neon) connection
# string. Locally you may leave this unset to use a local SQLite file.
DATABASE_URL=postgresql://user:password@host/database

# OpenAI (optional). Used to generate quiz questions with gpt-4o-mini.
# If unset or invalid, the quiz uses the built-in fallback questions.
OPENAI_API_KEY=
