# =========================================================================
# SMART STUDY PLANNER - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to '.env' and fill in your details. Never commit '.env' to git!
# =========================================================================

# Flask configuration
FLASK_SECRET_KEY=generate_a_cryptographically_secure_random_key_here

# OpenAI configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Database Configuration (Docker defaults shown below)
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=smart_study
MYSQL_USER=study_user
MYSQL_PASSWORD=study_secure_pass
MYSQL_ROOT_PASSWORD=rootpassword
